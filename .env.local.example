# Copy to .env.local and fill in from your Supabase project (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS and can reach the auth schema - never expose it to the browser.
# Needed by the ingestion scripts and by /admin (user management, sign-in log).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the sign-in link in account emails and the password-reset
# redirect. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outbound mail (new-account and new-password emails), sent through Resend.
# Supabase's built-in sender shares a domain with every other project on the
# platform, which is why its mail kept landing in university junk folders -
# these send from a domain you verify yourself instead.
# Get a key at https://resend.com and verify your sending domain there.
# Without both of these nothing is emailed: accounts are still created and
# /admin shows the temporary password for you to pass on by hand.
RESEND_API_KEY=
# Must be at a domain verified in Resend, e.g. "Published Landscape <no-reply@yourdomain.org>".
EMAIL_FROM=

# Used only by scripts/enrich_missing_abstracts.py (not the Next.js app).
# Free key from https://dev.springernature.com/ - falls back to this only
# when PubMed doesn't have the abstract for a Springer-published article.
SPRINGER_META_API_KEY=
