# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# local Claude Code session state
/.claude/

# local-only pricing / cost docs (never publish to the public repo)
/docs/

# course materials: institutional syllabi and publisher PDFs. Local-only -
# the PDFs are licensed to the individual/institution, not redistributable,
# and this repo is public.
/Core Courses Syllabi/
/Course Articles/
/syllabi.zip

# commercial market analysis for the publishing venture. Local-only - names
# specific societies as acquisition targets and carries pricing assumptions.
# This repo is public.
/Market Analysis/

# python
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts

# static demo: data/corpus.json is the single source of truth; the deploy
# workflow copies it into demo/data/ at build time rather than committing
# a second 7MB copy.
/demo/data/corpus.json
